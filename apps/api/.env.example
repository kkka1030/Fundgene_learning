FUNDGENE_APP_NAME=FundGene API
FUNDGENE_APP_ENV=development
FUNDGENE_API_PREFIX=/api
FUNDGENE_DATABASE_URL=postgresql+psycopg://fundgene:fundgene@localhost:5432/fundgene
FUNDGENE_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
FUNDGENE_ADVISOR_MODEL=deepseek:deepseek-v4-pro
FUNDGENE_AGENT_MODE=hybrid
FUNDGENE_AGENT_MODEL_TIMEOUT_MS=30000
FUNDGENE_DEEPSEEK_API_KEY=
FUNDGENE_DEEPSEEK_THINKING=disabled
FUNDGENE_DEEPSEEK_REASONING_EFFORT=high
